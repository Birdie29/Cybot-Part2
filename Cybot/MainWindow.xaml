<Window x:Class="Cybot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cybot"
        mc:Ignorable="d"
        Title="Cybot" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="90*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90*"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="/images/asciiart.png" Margin="0,0,0,87" Grid.RowSpan="2">
        </Image>

        <Grid Grid.Row="2">
            <RichTextBox/>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" HorizontalContentAlignment="Center" Content="Please enter your name:" FontWeight="Bold" FontSize="19" FontFamily="Cascadia Mono" Foreground="Blue"></Label>
            <TextBox Grid.Column="1" Name="username" HorizontalContentAlignment="Left" VerticalAlignment="Center" Foreground="Cyan" Width="250" Padding="10,8,10,8"></TextBox>
            <TextBlock Grid.Row="2" Name="message" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold" FontSize="9" FontFamily="Cascadia Mono"></TextBlock>
            <Button Grid.Column="2" Name="Send" Click="PressClick" Width="80" BorderBrush="Blue" BorderThickness="3" VerticalAlignment="Top" HorizontalAlignment="Center" Content="Send"  FontSize="19" FontWeight="Bold" Foreground="Aqua" Background="Blue" Height="66" FontFamily="Cascadia Mono" VerticalContentAlignment="Center"></Button>


        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280*"/>
                <ColumnDefinition Width="280*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" HorizontalContentAlignment="Left" Content="Enter your favourite topic:" FontSize="19" FontWeight="Bold" FontFamily="Cascadia Mono" Foreground="Blue"></Label>
            <TextBox Grid.Column="1" Name="favTopic" Width="250" Padding="10,8,10,8" Foreground="Cyan" FontFamily="Cascadia Mono" FontWeight="Bold"></TextBox>
            <TextBlock Grid.Column="0" Name="fav" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>

        </Grid>

        <Grid Grid.Row="5">

            <Label Grid.Row="5" Content="Here's a list of some topics we can dive right into:" FontSize="19" FontWeight="Bold" Foreground="Blue" FontFamily="Cascadia Mono"></Label>
            
        </Grid>

        <StackPanel Grid.Row="6">
            <TextBlock Text="~Password Safety" Width="200" HorizontalAlignment="Left" FontFamily="Cascadia Mono" FontSize="19" FontWeight="Bold" Foreground="Blue"/>
            <TextBlock Text="~Phishing"  Width="200"  HorizontalAlignment="Left" FontFamily="Cascadia Mono" FontSize="19" FontWeight="Bold" Foreground="Blue"/>
            <TextBlock Text="Safe Browsing"  HorizontalAlignment="Left" FontFamily="Cascadia Mono" FontSize="19" FontWeight="Bold" Foreground="Blue"/>
        </StackPanel>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Label Name="botTopics" Content="Enter your topic of choice please:" FontFamily="Cascadia Mono" FontSize="19" FontWeight="Bold" Foreground="Blue"></Label>
            <TextBox Grid.Column="1" Name="choice" Width="350"  Height="60" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="Cyan" FontSize="9" FontWeight="Bold"></TextBox>
            
        </Grid>

        <TextBlock Grid.Row="9" Name="paragrapgh" HorizontalAlignment="Center"></TextBlock>
        
        
    </Grid>
</Window>
